# Supabase (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# AI Provider (Choose ONE - tries in order: OpenAI → Groq → Claude)
# Option 1: OpenAI (free $5 credit for new accounts) - RECOMMENDED
OPENAI_API_KEY=sk-proj-your_openai_key_here

# Option 2: Groq (completely free, unlimited) - BEST FOR TESTING
# GROQ_API_KEY=gsk_your_groq_key_here

# Option 3: Claude (paid, $5 minimum) - BEST QUALITY
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
